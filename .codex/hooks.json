{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"scripts/python-hook-runner.mjs\" \".codex/hooks/inject-workflow-state.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(?:trellis-implement|trellis-check|trellis-research)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"scripts/python-hook-runner.mjs\" \".codex/hooks/inject-subagent-context.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
